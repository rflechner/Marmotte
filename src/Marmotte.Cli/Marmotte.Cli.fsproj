<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="ConsoleDsl.fs" />
        <Compile Include="GgufReport.fs" />
        <Compile Include="SafetensorsReport.fs" />
        <Compile Include="InfoCommand.fs" />
        <Compile Include="QuantizeCommand.fs" />
        <Compile Include="Program.fs"/>
        <None Include="Properties/launchSettings.json" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.Core" ExcludeAssets="contentFiles" />
        <PackageReference Include="Spectre.Console" />
        <PackageReference Include="Spectre.Console.Cli" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Marmotte.Gguf/Marmotte.Gguf.fsproj" />
        <ProjectReference Include="../Marmotte.Safetensors/Marmotte.Safetensors.fsproj" />
    </ItemGroup>

</Project>
