<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Types.fs"/>
        <Compile Include="Gguf.fs"/>
        <Compile Include="GgufModelConfiguration.fs" />
        <Compile Include="GgufTokenizer.fs" />
        <Compile Include="GgufTensorSource.fs" />
        <Compile Include="GgufModelTensorLayout.fs" />
        <Compile Include="QuantizationCodec.fs" />
        <Compile Include="GgufWriter.fs" />
        <Compile Include="GgufQuantizer.fs" />
        <None Include="GgufScript.fsx" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.Core" ExcludeAssets="contentFiles" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Marmotte.Core/Marmotte.Core.fsproj" />
    </ItemGroup>

</Project>
