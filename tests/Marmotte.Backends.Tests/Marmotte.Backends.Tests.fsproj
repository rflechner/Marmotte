<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="BackendTests.fs" />
    <Compile Include="EmbeddingTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" ExcludeAssets="contentFiles" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Marmotte.Core/Marmotte.Core.fsproj" />
    <ProjectReference Include="../../src/Marmotte.Cpu/Marmotte.Cpu.fsproj" />
    <ProjectReference Include="../../src/Marmotte.Cuda/Marmotte.Cuda.fsproj" />
    <ProjectReference Include="../../src/Marmotte.Metal/Marmotte.Metal.fsproj" />
  </ItemGroup>
</Project>
